# ===== 必填：以下为示例值，直接复制使用会被拒绝启动 =====
DATABASE_URL=mysql://manner:Change_Me_123@127.0.0.1:3306/manner_web
JWT_SECRET=CHANGE_ME_this_is_an_example_jwt_secret_please_generate_a_64_char_random_one
FIELD_ENC_KEY=CHANGE_ME_example_field_enc_key_please_use_random

# ===== 可选（留空使用默认值） =====
BCRYPT_COST=12
TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOG_LEVEL=debug
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
UPLOAD_DIR=./uploads
LOG_FILE=./logs/manner.log
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_WINDOW_SECS=900
COOKIE_SECURE=false
# 可信反向代理 IP（单 IP 或 CIDR，逗号分隔）。直连部署留空；经 Nginx 反代时应设为
# 代理机地址（如 127.0.0.1），后端将信任 X-Real-IP 解析真实客户端 IP 用于登录限流与日志。
TRUSTED_PROXIES=
# 设为 production 时启用 JSON 滚动日志
PROFILE=
